{
  "name": "@umstek/fastmcp-boilerplate",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build ./src/server.ts --target node --outdir ./dist --minify",
    "start": "bun run dist/server.js",
    "dev:server": "bun --watch src/server.ts",
    "dev:client": "bun --watch src/client.ts",
    "check": "biome check . --write",
    "check:unsafe": "biome check . --write --unsafe"
  },
  "keywords": [
    "fastmcp",
    "mcp",
    "boilerplate"
  ],
  "repository": {
    "url": "https://github.com/umstek/fastmcp-boilerplate.git"
  },
  "author": "Wickramaranga Abeygunawardhana <umstek@live.com>",
  "homepage": "https://github.com/umstek/fastmcp-boilerplate",
  "type": "module",
  "license": "MIT",
  "description": "A boilerplate for FastMCP",
  "dependencies": {
    "fastmcp": "^3.14.0",
    "zod": "^4.0.15",
    "@modelcontextprotocol/sdk": "^1.17.1"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/bun": "^1.2.19",
    "jiti": "^2.5.1",
    "semantic-release": "^24.2.7",
    "typescript": "^5.9.2"
  },
  "private": false,
  "peerDependencies": {
    "@valibot/to-json-schema": "^1.3.0",
    "effect": "^3.17.7",
    "sury": "^11.0.0-alpha.2"
  }
}
