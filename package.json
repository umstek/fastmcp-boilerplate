{
  "name": "fastmcp-boilerplate",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build ./src/server.ts --outdir ./dist --target node",
    "start": "bun run dist/server.js",
    "dev": "bun x --bun @wong2/mcp-cli bun src/server.ts",
    "check": "biome check . --write",
    "check:unsafe": "biome check . --write --unsafe"
  },
  "keywords": [
    "fastmcp",
    "mcp",
    "boilerplate"
  ],
  "repository": {
    "url": "https://github.com/punkpeye/fastmcp-boilerplate"
  },
  "author": "Frank Fiegel <frank@glama.ai>",
  "homepage": "https://glama.ai/mcp",
  "type": "module",
  "license": "MIT",
  "description": "A boilerplate for FastMCP",
  "dependencies": {
    "fastmcp": "^3.14.0",
    "zod": "^4.0.15"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/bun": "^1.2.19",
    "jiti": "^2.5.1",
    "semantic-release": "^24.2.7",
    "typescript": "^5.9.2"
  },
  "private": true
}
