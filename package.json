{
  "name": "fastmcp-boilerplate",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev": "fastmcp dev src/server.ts",
    "lint": "bun x @biomejs/biome check . && tsc --noEmit",
    "test": "vitest run",
    "format": "bun x @biomejs/biome format --write . && bun x @biomejs/biome check --write ."
  },
  "keywords": [
    "fastmcp",
    "mcp",
    "boilerplate"
  ],
  "repository": {
    "url": "https://github.com/punkpeye/fastmcp-boilerplate"
  },
  "author": "Frank Fiegel <frank@glama.ai>",
  "homepage": "https://glama.ai/mcp",
  "type": "module",
  "license": "MIT",
  "description": "A boilerplate for FastMCP",
  "dependencies": {
    "fastmcp": "^3.14.0",
    "zod": "^4.0.15"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@total-typescript/tsconfig": "^1.0.4",
    "jiti": "^2.5.1",
    "semantic-release": "^24.2.7",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
